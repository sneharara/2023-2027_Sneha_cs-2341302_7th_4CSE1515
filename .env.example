# SMTP Server configuration (Default is Gmail)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# Your Gmail address used to send alerts
SENDER_EMAIL=your_email@gmail.com

# Your Gmail App Password (NOT your regular account password)
# Guide to get App Password: https://support.google.com/accounts/answer/185833
SENDER_PASSWORD=your_app_password

# Email address that will receive the fire/smoke alert notifications
RECEIVER_EMAIL=recipient_email@example.com
